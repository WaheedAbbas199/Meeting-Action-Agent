# Copy to .env (never commit .env). Every value below is a placeholder.
APP_ENV=development            # development | test | production
DATABASE_URL=sqlite:///./data/maa.db   # production: postgresql+psycopg://user:pass@host:5432/db
JWT_SECRET=                    # REQUIRED in production: 32+ random characters (openssl rand -hex 32)
ALLOW_SIGNUP=true

# AI (heuristic = rule-based fallback, no model, no credentials)
LLM_PROVIDER=heuristic         # heuristic | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash  # verify this model is available to your key
STT_PROVIDER=none              # none | gemini

# Messaging: everything is disabled until you configure and authorize it
EMAIL_PROVIDER=disabled        # disabled | mock (dev only) | gmail
WHATSAPP_PROVIDER=disabled     # disabled | mock (dev only) | cloud
CALENDAR_PROVIDER=disabled     # disabled | mock (dev only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=        # approved template, required for business-initiated messages

# Safety limits
APPROVAL_TTL_HOURS=24
SENDS_PER_HOUR=30
JOB_MAX_ATTEMPTS=3
